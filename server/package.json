{
  "name": "@dsh-work/server",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --experimental-strip-types src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "node --env-file-if-exists=../.env --experimental-strip-types src/infrastructure/postgres/migrate.ts",
    "test:m2": "node --experimental-strip-types --test src/modules/run/run-state-machine.test.ts src/modules/model/model-governance-service.test.ts",
    "test:m2:integration": "node --experimental-strip-types --test src/infrastructure/postgres/postgres-repositories.integration.test.ts",
    "test:m3:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m3-orchestration.integration.test.ts",
    "test:m4:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-agent-management.integration.test.ts",
    "test:m4:skill:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-skill-management.integration.test.ts",
    "test:m4:tool:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-tool-connector-management.integration.test.ts",
    "test:m4:knowledge:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-enterprise-knowledge.integration.test.ts",
    "test:m4:file": "node --experimental-strip-types --test src/modules/workbench/application/document-extractor.test.ts",
    "test:m4:file:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-file-analysis.integration.test.ts",
    "test:m4:authorization:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-authorization.integration.test.ts",
    "test:m4:runtime:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-runtime-operations.integration.test.ts",
    "test:m4:audit:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-audit-operations.integration.test.ts",
    "test:m4:error": "node --experimental-strip-types --test src/http/router-error-experience.test.ts",
    "test:m4:error:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m4-notification-error-experience.integration.test.ts",
    "test:m5:api": "node --experimental-strip-types --test src/http/api-contract.test.ts src/http/router-error-experience.test.ts",
    "test:m5:security": "node --experimental-strip-types --test src/security/safe-observability.test.ts config/dsh/dsh-work-tool-policy.test.js",
    "test:m5:security:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m5-security-regression.integration.test.ts",
    "test:m5:faults": "node --experimental-strip-types --test src/http/sse-reconnect.test.ts",
    "test:sso": "node --experimental-strip-types --test src/modules/identity/identity.test.ts",
    "test:sso:integration": "node --experimental-strip-types --test src/modules/identity/identity.integration.test.ts",
    "test:m5:faults:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m5-runtime-faults.integration.test.ts",
    "test:m5:capacity:integration": "node --experimental-strip-types --test src/infrastructure/postgres/m5-capacity.integration.test.ts",
    "test:runtime": "node --experimental-strip-types --test src/modules/runtime/runtime-adapter.test.ts config/dsh/dsh-work-tool-policy.test.js",
    "start": "node dist/main.js"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "typescript": "~5.9.3"
  },
  "dependencies": {
    "postgres": "^3.4.9"
