{
  "name": "dsh-work",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "pnpm dev:all",
    "dev:server": "pnpm --filter @dsh-work/server dev",
    "dev:workbench": "pnpm --filter @dsh-work/workbench-web dev",
    "dev:admin": "pnpm --filter @dsh-work/admin-web dev",
    "dev:all": "pnpm --parallel --filter @dsh-work/server --filter @dsh-work/workbench-web --filter @dsh-work/admin-web dev",
    "build": "pnpm --filter './apps/*' --filter @dsh-work/server build",
    "typecheck": "pnpm --filter './apps/*' --filter @dsh-work/server typecheck",
    "test:m1": "pnpm --filter @dsh-work/server test:runtime",
    "test:m2": "pnpm --filter @dsh-work/server test:m2",
    "test:m2:integration": "pnpm --filter @dsh-work/server test:m2:integration",
    "test:m3:integration": "pnpm --filter @dsh-work/server test:m3:integration",
    "test:m4:integration": "pnpm --filter @dsh-work/server test:m4:integration",
    "test:m4:skill:integration": "pnpm --filter @dsh-work/server test:m4:skill:integration",
    "test:m4:tool:integration": "pnpm --filter @dsh-work/server test:m4:tool:integration",
    "test:m4:knowledge:integration": "pnpm --filter @dsh-work/server test:m4:knowledge:integration",
    "test:m4:file": "pnpm --filter @dsh-work/server test:m4:file",
    "test:m4:file:integration": "pnpm --filter @dsh-work/server test:m4:file:integration",
    "test:m4:authorization:integration": "pnpm --filter @dsh-work/server test:m4:authorization:integration",
    "test:m4:runtime:integration": "pnpm --filter @dsh-work/server test:m4:runtime:integration",
    "test:m4:audit:integration": "pnpm --filter @dsh-work/server test:m4:audit:integration",
    "test:m4:error": "pnpm --filter @dsh-work/server test:m4:error",
    "test:m4:error:integration": "pnpm --filter @dsh-work/server test:m4:error:integration",
    "test:m5:frontend": "pnpm --filter @dsh-work/workbench-web --filter @dsh-work/admin-web test",
    "test:m5:api": "pnpm --filter @dsh-work/server test:m5:api",
    "test:m5:security": "pnpm --filter @dsh-work/server test:m5:security",
    "test:m5:security:integration": "pnpm --filter @dsh-work/server test:m5:security:integration",
    "test:m5:faults": "pnpm --filter @dsh-work/server test:m5:faults",
    "test:m5:faults:integration": "pnpm --filter @dsh-work/server test:m5:faults:integration",
    "test:m5:capacity:integration": "pnpm --filter @dsh-work/server test:m5:capacity:integration",
    "test:e2e": "playwright test",
    "check:secrets": "node scripts/check-secrets.mjs",
    "probe:m1": "node --experimental-strip-types scripts/probe-dsh-acp.ts",
    "probe:m1:real": "node --experimental-strip-types scripts/probe-dsh-acp-real.ts",
    "probe:m1:tool": "node --experimental-strip-types scripts/probe-dsh-acp-real.ts --tool",
    "probe:m1:artifact": "node --experimental-strip-types scripts/probe-dsh-acp-real.ts --artifact",
    "probe:m1:cancel": "node --experimental-strip-types scripts/probe-dsh-acp-cancel.ts",
    "probe:m1:concurrency": "node --experimental-strip-types scripts/probe-dsh-acp-concurrency.ts",
    "verify:m0": "node scripts/verify-m0.mjs",
    "verify:m1": "node scripts/verify-m1.mjs",
    "verify:m2": "node scripts/verify-m2.mjs",
    "verify:m3": "node scripts/verify-m3.mjs",
    "verify:m4:agent": "node scripts/verify-m4-agent.mjs",
    "verify:m4:skill": "node scripts/verify-m4-skill.mjs",
    "verify:m4:tool": "node scripts/verify-m4-tool.mjs",
    "verify:m4:knowledge": "node scripts/verify-m4-knowledge.mjs",
    "verify:m4:file": "node scripts/verify-m4-file.mjs",
    "verify:m4:authorization": "node scripts/verify-m4-authorization.mjs",
    "verify:m4:runtime": "node scripts/verify-m4-runtime.mjs",
    "verify:m4:audit": "node scripts/verify-m4-audit.mjs",
    "verify:m4:error": "node scripts/verify-m4-error.mjs",
    "verify:m4": "node scripts/verify-m4.mjs",
    "verify:m5:test": "node scripts/verify-m5-test-baseline.mjs",
    "verify:m5:security": "node scripts/verify-m5-security.mjs",
    "verify:m5:faults": "node scripts/verify-m5-faults.mjs",
    "verify:m5:capacity": "node scripts/verify-m5-capacity.mjs",
    "ci:check": "pnpm verify:m0 && pnpm verify:m1 && pnpm verify:m2 && pnpm verify:m3 && pnpm verify:m4:agent && pnpm verify:m4:skill && pnpm verify:m4:tool && pnpm verify:m4:knowledge && pnpm verify:m4:file && pnpm verify:m4:authorization && pnpm verify:m4:runtime && pnpm verify:m4:audit && pnpm verify:m4:error && pnpm verify:m4 && pnpm verify:m5:test && pnpm verify:m5:security && pnpm verify:m5:faults && pnpm verify:m5:capacity && pnpm check:secrets && pnpm typecheck && pnpm test:m1 && pnpm test:m2 && pnpm test:m4:file && pnpm test:m4:error && pnpm test:m5:frontend && pnpm test:m5:api && pnpm test:m5:security && pnpm test:m5:faults && pnpm lint && pnpm build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "validate:ui": "pnpm --filter @dsh-work/admin-web --filter @dsh-work/workbench-web validate:ui",
    "lint": "pnpm check:architecture && pnpm validate:ui && eslint apps packages server scripts --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@playwright/test": "^1.62.1",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^9.37.0",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^16.4.0",
    "happy-dom": "^20.11.15",
    "typescript-eslint": "^8.46.1",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.2.0"
  }
}
