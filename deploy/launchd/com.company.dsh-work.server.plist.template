<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.company.dsh-work.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DEPLOY_ROOT__/current/scripts/deploy/run-server.sh</string>
    <string>__DEPLOY_ROOT__</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__DEPLOY_ROOT__/current</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ProcessType</key>
  <string>Background</string>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>__DEPLOY_ROOT__/logs/server.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__DEPLOY_ROOT__/logs/server.stderr.log</string>
</dict>
</plist>
