map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# Browser caching for the two SPAs. index.html (the entry page and the fallback for every client
# route) must be revalidated on each load, otherwise browsers apply heuristic freshness from
# Last-Modified and keep showing the previous release for hours after an upgrade. Files under
# /assets/ carry a content hash in their names and never change, so they can be cached for a year.
# Proxied paths (/api/, /auth/, /health) keep whatever the server sends: an empty value adds nothing.
map $uri $dsh_work_static_cache_control {
  default "";
  /index.html "no-cache";
  ~^/assets/ "public, max-age=31536000, immutable";
}

upstream dsh_work_server {
  server host.docker.internal:${DSH_WORK_SERVER_PORT};
  keepalive 32;
}

server {
  listen 8443 ssl default_server;
  listen 8444 ssl default_server;
  server_name _;

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;

  return 421;
}

server {
  listen 8443 ssl;
  server_name ${DSH_WORK_WORKBENCH_SERVER_NAMES};

  ssl_certificate /etc/dsh-work/tls/server.crt;
  ssl_certificate_key /etc/dsh-work/tls/server.key;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_session_cache shared:DSHWORK:10m;
  ssl_session_timeout 1d;

  # Both portals: no framing by other sites, no MIME sniffing, HTTPS only.
  # HSTS deliberately omits includeSubDomains; browsers ignore it for bare IP hosts.
  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Frame-Options "DENY" always;
  add_header Content-Security-Policy "frame-ancestors 'none'" always;
  add_header X-Content-Type-Options "nosniff" always;
  add_header Referrer-Policy "same-origin" always;
  # Declared at server level (not inside a location) so the security headers above stay inherited.
  add_header Cache-Control $dsh_work_static_cache_control;

  root /srv/workbench;
  index index.html;
  client_max_body_size 50m;

  location = /health/live {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location = /health {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  location /api/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
    proxy_buffering off;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
  }

  location /auth/ {
    proxy_pass http://dsh_work_server;
    include /etc/nginx/proxy_params;
  }

  # Hashed build output. A file missing here is a chunk from an earlier release requested by a tab
  # opened before the upgrade: answer 404 (not index.html as HTML-with-200) so the page sees a real
  # load failure and reloads once. No add_header here, so the server-level headers stay inherited.
  location /assets/ {
    try_files $uri =404;
  }

  location / {
    try_files $uri $uri/ /index.html;
  }
}

