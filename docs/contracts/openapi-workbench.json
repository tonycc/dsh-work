          }
        }
      }
    },
    "/artifacts": {
      "get": {
        "operationId": "listArtifacts",
        "summary": "查询当前员工可见成果",
        "parameters": [],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        },
        "description": "返回当前员工可见的成果（本人会话产生的成果）。团队空间的成果与被移出/退出成员的空间读权限同一口径：失去空间读权限后该空间成果不再返回；个人空间成果不受影响（AC-09/AC-23）。"
      }
    },
    "/files/{fileId}/download": {
      "parameters": [
        {
