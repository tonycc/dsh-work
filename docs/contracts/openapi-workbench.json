          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "downloadArtifact",
        "summary": "鉴权后下载成果最新版本",
        "description": "团队空间成果读取与运行同一收权口径：失去当前读权限后返回 403，且错误与成果不存在同口径以避免用 artifactId 枚举对象；个人空间保持原路径（AC-23）。",
        "responses": {
          "200": {
            "description": "文件内容",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
