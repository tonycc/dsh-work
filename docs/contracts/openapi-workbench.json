    "/workspaces/{workspaceId}/sessions": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listWorkspaceSessions",
        "summary": "分页查询团队空间中本人发起的历史会话",
        "description": "按最近活动倒序返回 Session 摘要（稳定 Session 身份、标题、发起人、最近活动时间、Run 计数与最新 Run 指针），不含对话正文。范围固定为调用者本人发起的会话（服务端按 created_by 强制过滤，不接受范围参数）；keyset 游标分页 + 标题关键词过滤；不返回其他成员的标题、摘要或数量。任何当前成员可读本人范围，非成员与个人空间被拒绝。3-T1 读取轨：空间归档后现任成员仍可读取本人范围的历史会话；非成员与不存在空间按不可枚举文案拒绝。",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "标题关键词"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "上一页返回的 nextCursor"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/files/{fileId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        },
        {
          "name": "fileId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "operationId": "removeWorkspaceFile",
        "summary": "逻辑移除团队空间共享文件（负责人/管理员/上传人）",
        "description": "逻辑移除：文件对象、解析结果与历史 Run 引用保留，但不再出现在可引用列表且旧 ID 下载被拒绝。只读成员不可移除。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/archive": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "post": {
        "operationId": "archiveTeamWorkspace",
        "summary": "归档团队空间（仅负责人）",
        "description": "仅空间负责人可归档。归档是「只读保留」：写入 archived_at 并置 status=archived，此后现任成员仍可按读取轨查看会话、文件、成果与历史运行，写路径（新对话、续写、重试、上传、成员与设置变更）一律拒绝；归档空间仍允许紧急撤销访问与负责人转交。空间存在排队/运行中/取消中的 Run 时拒绝归档并提示等待或取消（不自动中断在途任务），返回 409 state_conflict。个人空间不可归档（422）。每次归档写入审计事实。并发：归档与开跑/领取排队任务通过 workspace 行锁串行化。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/restore": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "post": {
        "operationId": "restoreTeamWorkspace",
        "summary": "恢复已归档团队空间（仅负责人）",
        "description": "仅空间负责人可恢复。清空当前归档时间（archived_at 置空）并置 status=active，恢复后写入口按当前权限重新出现。恢复不重新添加已移除成员、不扩大授权，也不改变成员角色。个人空间不可恢复（422）。每次恢复写入审计事实。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "enterpriseSession": {
        "type": "apiKey",
        "in": "cookie",
        "name": "dsh_work_session",
        "description": "AI Hub OIDC 回调后由 dsh-work 设置的不透明 HttpOnly Session Cookie；生产名称使用 __Host- 前缀。"
      }
    },
    "parameters": {
      "WorkspaceId": {
        "name": "workspaceId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "SessionId": {
        "name": "sessionId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Ok": {
        "description": "成功",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Envelope"
            }
          }
        }
      },
      "Error": {
        "description": "失败",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorEnvelope"
            }
          }
        }
      }
    },
    "schemas": {
      "Envelope": {
        "type": "object",
        "required": [
          "data",
          "meta"
        ],
        "properties": {
          "data": {},
          "meta": {
            "$ref": "#/components/schemas/Meta"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "object",
              "suggestion",
              "traceId"
            ],
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "object": {
                "type": "string"
              },
              "suggestion": {
                "type": "string"
              },
              "traceId": {
                "type": "string"
              }
            }
          }
        }
      },
      "Meta": {
        "type": "object",
        "required": [
          "requestId",
          "timestamp"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "TeamMemberRole": {
        "type": "string",
        "enum": [
          "owner",
          "admin",
          "member",
          "viewer"
        ],
        "description": "团队空间员工角色：负责人、管理员、成员、只读成员。"
      },
      "MemberCandidate": {
        "type": "object",
        "required": [
          "id",
          "displayName",
          "department"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "department": {
            "type": "string"
          }
        },
        "description": "成员选择所需的最小员工字段；不暴露管理端全量身份数据。"
      },
      "MemberCandidatePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MemberCandidate"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WorkspaceMember": {
        "type": "object",
        "required": [
          "userId",
          "displayName",
          "role",
          "joinedAt"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/TeamMemberRole"
          },
          "joinedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MemberAddRequest": {
        "type": "object",
        "required": [
          "userId",
          "role"
        ],
        "properties": {
          "userId": {
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/TeamMemberRole"
          }
        }
      },
      "MemberRoleChangeRequest": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "$ref": "#/components/schemas/TeamMemberRole"
          }
        }
      },
      "OwnerTransferRequest": {
        "type": "object",
        "required": [
          "toUserId"
        ],
        "properties": {
          "toUserId": {
            "type": "string"
          }
        }
      },
      "AgentCandidate": {
        "type": "object",
        "required": [
          "agentId",
          "name",
          "description",
          "activeVersionId",
          "activeVersion",
          "status"
        ],
        "properties": {
          "agentId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Agent 职责说明。"
          },
          "activeVersionId": {
            "type": "string"
          },
          "activeVersion": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "published"
            ]
          }
        },
        "description": "候选选择所需的最小 Agent 字段；不暴露模型、凭据与 Skill/Tool 配置明细。"
      },
      "AgentCandidatePage": {
        "type": "object",
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentCandidate"
            }
          },
          "nextCursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "WorkspaceAgentMember": {
        "type": "object",
        "required": [
          "id",
          "agentId",
          "name",
          "description",
          "status",
          "version",
          "addedBy",
          "createdAt",
          "allowedActions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Agent 成员关联 ID（wam- 前缀）。"
          },
          "agentId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "disabled"
            ]
          },
          "version": {
            "type": "string",
            "description": "成员固定（pinned）的 Agent 版本。"
          },
          "addedBy": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "allowedActions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "start_conversation",
                "disable",
                "enable",
                "upgrade",
                "remove"
              ]
            },
            "description": "当前操作人允许的动作：负责人可用状态为 start_conversation/disable/upgrade/remove，停用状态为 enable/remove；管理员与成员仅在可用状态有 start_conversation；只读成员为空。"
          }
        }
      },
      "AgentMemberAddRequest": {
        "type": "object",
        "required": [
          "agentId"
        ],
        "properties": {
          "agentId": {
            "type": "string"
          }
        }
      },
      "AgentMemberUpdateRequest": {
        "type": "object",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "disable",
              "enable",
              "upgrade"
            ]
          }
        }
      }
    }
  },
  "x-contract-status": "m6-implemented"
}
