{
  "openapi": "3.1.0",
  "info": {
    "title": "dsh-work 员工工作台 API",
    "version": "0.6.0-m6",
    "description": "请求使用 AI Hub OIDC 登录后由 dsh-work 签发的 HttpOnly 服务端 Session；AI Hub 只提供用户身份，工作台角色、权限和数据范围由 dsh-work 本地配置且不接受浏览器传入。每位用户具有唯一默认个人工作空间，所有 Session、文件与成果均归属个人或团队工作空间。"
  },
  "servers": [
    {
      "url": "/api/workbench/v1"
    }
  ],
  "security": [
    {
      "enterpriseSession": []
    }
  ],
  "paths": {
    "/session": {
      "get": {
        "operationId": "getCurrentSession",
        "summary": "获取当前员工身份与权限上下文",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/agents": {
      "get": {
        "operationId": "listAvailableAgents",
        "summary": "按当前员工角色查询可用的已发布 Agent",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/skills": {
      "get": {
        "operationId": "listAvailableSkills",
        "summary": "查询当前员工可查看的已发布 Skill 广场目录",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces": {
      "get": {
        "operationId": "listMyWorkspaces",
        "summary": "查询当前员工的个人工作空间和已加入的团队工作空间",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          }
        },
        "description": "返回当前员工的个人工作空间与已加入的团队工作空间，并带团队归档状态。status 过滤：all（默认，设计 §2.1/§6「默认全部；个人空间恒显」）、active（个人空间恒为 active，团队空间仅返回活动状态）、archived（3-T3 归档筛选：只返回调用者仍是现任成员的已归档团队空间，个人空间不出现，非成员与不存在空间不可枚举）。owner 为 workspace_members.member_role='owner' 的当前负责人（转交后随之变化），created_by 仅作异常兜底。",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "active",
                "archived",
                "all"
              ],
              "default": "all"
            },
            "description": "active=仅活动；archived=仅已归档；all=全部（默认，设计 §2.1「默认全部；个人空间恒显」）"
          }
        ]
      }
    },
    "/workspaces/{workspaceId}/files": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listWorkspaceFiles",
        "summary": "查询团队空间共享文件（所有成员）",
        "description": "按名称搜索、keyset 分页返回空间内可引用的共享文件；已逻辑移除的文件不再出现。响应含服务端判定的 removable（负责人/管理员可移除任何文件，成员仅自己上传的）与 canDownload。个人空间被拒绝。读取轨（3-T1 归档=只读保留）：空间归档后现任成员仍可列出与下载，此时 removable 一律为 false（移除属执行轨，归档空间拒绝）；上传与移除仍要求活跃空间。非成员与不存在空间不可枚举。",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "名称关键词"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "uploadWorkspaceFile",
        "summary": "上传工作空间共享文件",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "file"
                ],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/member-candidates": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listMemberCandidates",
        "summary": "搜索可添加为团队空间成员的企业业务员工（仅负责人/管理员）",
        "description": "仅返回团队空间成员选择所需的姓名、部门等最小字段；离职、停用、无应用访问资格与已加入成员不可选。个人工作空间不支持。",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "按姓名模糊搜索；省略时按目录顺序返回。"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "上一页返回的 nextCursor 游标。"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "候选人分页结果（envelope.data 为 MemberCandidatePage）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/members": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listWorkspaceMembers",
        "summary": "查询团队空间的员工成员列表（所有成员）",
        "description": "任何当前成员都可读取成员名册；响应额外返回调用者自己的角色 currentUserRole，供员工端按服务端判定渲染允许动作（负责人转交后创建者不再是负责人）。个人工作空间不支持，非成员被拒绝。 读取轨（3-T1 归档=只读保留）：归档空间的现任成员仍可读取名册，便于归档详情展示成员身份；非成员与不存在空间拒绝。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "addWorkspaceMember",
        "summary": "从企业业务员工目录添加团队成员（仅负责人/管理员）",
        "description": "管理员只能添加成员/只读成员，负责人可任命管理员；重复添加同一角色幂等，角色变更请使用 PATCH。个人工作空间不支持。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberAddRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          },
          "200": {
            "description": "重复添加同一角色时返回当前成员状态",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/members/{userId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        },
        {
          "name": "userId",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "patch": {
        "operationId": "updateMemberRole",
        "summary": "调整团队成员角色（仅负责人/管理员）",
        "description": "管理员仅可调整成员/只读成员；负责人可任免管理员；负责人角色只能通过负责人转交变更。个人工作空间不支持。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MemberRoleChangeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "removeWorkspaceMember",
        "summary": "移除团队成员（仅负责人/管理员）",
        "description": "保留其共享贡献与作者归属；管理员不能移除管理员或负责人，唯一负责人必须先行转交。个人工作空间不支持。 治理例外（3-T1）：紧急撤权在归档空间仍必须可用（归档不得阻止收权）；其余成员管理操作在归档空间拒绝。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/agent-candidates": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listWorkspaceAgentCandidates",
        "summary": "搜索可加入团队空间的平台 Agent 候选（仅负责人）",
        "description": "返回平台已发布、允许加入团队空间且对当前员工角色可见的 Agent 摘要（名称、职责、活动版本、状态），不返回模型、凭据与 Skill/Tool 配置明细；已加入的 Agent 不在候选内。个人工作空间不支持。",
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "按名称或职责关键字过滤；省略时返回全部候选。"
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "上一页返回的 nextCursor 游标。"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Agent 候选分页结果（envelope.data 为 AgentCandidatePage）",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Envelope"
                }
              }
            }
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/agent-members": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "get": {
        "operationId": "listWorkspaceAgentMembers",
        "summary": "查询团队空间的 Agent 成员列表（所有成员）",
        "description": "仅返回未移除的 Agent 成员，包含固定版本、加入人与当前操作人允许的动作；负责人看到管理动作，成员在可用状态看到「开始对话」。Agent 成员不套用员工角色语义。个人工作空间不支持。 读取轨（3-T1）：归档空间的现任成员仍可读取 Agent 名册；Agent 候选与加入/停用/升级/移出保持执行轨，在归档空间拒绝。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "post": {
        "operationId": "addWorkspaceAgentMember",
        "summary": "加入 Agent 成员并固定当前已发布版本（仅负责人）",
        "description": "服务端解析 Agent 活动版本并校验依赖（Agent 必须显式授权其 Skill 依赖的全部工具）；成员关系、授权来源与有效授权在同一事务写入，失败不部分保存；重复加入非移除成员返回冲突，移出后重新加入复用原成员行。个人工作空间不支持。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMemberAddRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/agent-members/{id}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        },
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          },
          "description": "Agent 成员关联 ID（wam- 前缀）。"
        }
      ],
      "patch": {
        "operationId": "updateWorkspaceAgentMember",
        "summary": "停用、重新启用或升级 Agent 成员（仅负责人）",
        "description": "停用撤销该关联的授权来源并写入撤权事件，共享工具授权由其他来源保留；重新启用以当前固定版本恢复授权来源（已移出成员须重新加入）；升级固定新版本并保留旧版本来源（既有会话继续执行）。个人工作空间不支持。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AgentMemberUpdateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      },
      "delete": {
        "operationId": "removeWorkspaceAgentMember",
        "summary": "移出 Agent 成员（仅负责人）",
        "description": "撤销该关联的授权来源并写入撤权事件，阻止后续会话启动；历史 Run、消息与成果保留，成员行保留审计并可重新加入。个人工作空间不支持。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/exit": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "post": {
        "operationId": "exitWorkspace",
        "summary": "非负责人成员主动退出团队空间",
        "description": "退出保留共享贡献与作者归属；负责人必须先转交。个人工作空间不支持。",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/workspaces/{workspaceId}/owner-transfer": {
      "parameters": [
        {
          "$ref": "#/components/parameters/WorkspaceId"
        }
      ],
      "post": {
        "operationId": "transferWorkspaceOwner",
        "summary": "转交团队空间负责人（仅负责人）",
        "description": "事务内锁定空间并互换新旧负责人角色，任何时刻恰好一名负责人；内容创建者字段保持不变。并发转交只允许一次成功。 治理例外（3-T1）：归档空间仍允许负责人转交（归档不得阻止负责人治理）。",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OwnerTransferRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          },
          "422": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/sessions": {
      "post": {
        "operationId": "createSession",
        "summary": "创建对话；workspaceId 省略时自动归入当前用户的默认个人空间",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "workspaceId": {
                    "type": "string",
                    "description": "个人或团队工作空间 ID；省略时由服务端选择默认个人空间。"
                  },
                  "agentId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "个人空间按当前可用 Agent 解析版本；团队空间不允许通过原始 agentId 选择，必须使用 workspaceAgentMemberId。"
                  },
                  "skillId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "员工从 Skill 广场选择的 Skill；服务端锁定其当前已发布版本。"
                  },
                  "workspaceAgentMemberId": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "团队空间发起对话必须携带的 Agent 成员关联 ID；服务端使用其固定版本并校验当前可用。个人空间忽略该字段。"
                  },
                  "title": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 120
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "$ref": "#/components/responses/Ok"
          }
        }
      }
    },
    "/sessions/{sessionId}/files": {
      "parameters": [
        {
          "$ref": "#/components/parameters/SessionId"
        }
      ],
