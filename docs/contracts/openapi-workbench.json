            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "downloadFile",
        "summary": "鉴权后下载文件对象",
        "description": "个人空间作者与团队空间当前成员可下载；团队空间失去当前读权限后返回 403，且错误与文件不存在同口径以避免用 fileId 枚举对象。",
        "responses": {
          "200": {
