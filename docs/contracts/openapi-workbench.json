        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "prompt",
                  "idempotencyKey"
                ],
                "properties": {
                  "prompt": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 20000
                  },
                  "fileIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "maxItems": 5,
                    "uniqueItems": true
                  },
                  "idempotencyKey": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 128
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "$ref": "#/components/responses/Ok"
          },
          "409": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/runs/{runId}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        }
      ],
      "get": {
        "operationId": "getRun",
        "description": "团队空间历史运行读取走读取轨（3-T1）：空间归档后现任成员仍可读取历史运行；非成员与不存在的空间一律按不可枚举的“不可访问”处理。",
        "summary": "获取 Run 当前状态",
        "responses": {
          "200": {
            "$ref": "#/components/responses/Ok"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/runs/{runId}/events": {
      "parameters": [
        {
          "$ref": "#/components/parameters/RunId"
        },
        {
          "name": "Last-Event-ID",
          "in": "header",
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "operationId": "streamRunEvents",
        "description": "团队空间事件流按读取轨交付（3-T1）：空间归档后现任成员仍可建流并接收历史事件；逐批写出前复核当前成员资格，撤权后立即停止交付。执行轨（排队领取与执行前复核）不因读取轨放宽而放行归档空间。",
        "summary": "通过 SSE 订阅可安全展示的 Run 事件",
        "responses": {
          "200": {
            "description": "SSE 事件流；事件结构见 run-event.schema.json",
