# dsh-work server
DSH_WORK_SERVER_HOST=127.0.0.1
DSH_WORK_SERVER_PORT=4190
DSH_WORK_DATABASE_URL=postgres://dsh_work:change-me@127.0.0.1:5432/dsh_work

# Local development fallback: a verified DSH source checkout.
# If omitted, dsh-work resolves ../deepseek-harness.
DSH_RUNTIME_HOME=/Users/max/projects/deepseek-harness
DSH_EXPECTED_VERSION=0.1.1-rc.2
DSH_EXPECTED_COMMIT=b150a551b8d465e31e418e1b2eaf5e79bbb7d28e

# Managed distribution mode: enable both variables below in staging/pilot.
# DSH_RUNTIME_COMMAND=/opt/dsh/runtime/bin/dsh-acp
# DSH_RUNTIME_ARGS_JSON=[]

# Model secrets are intentionally absent. DSH resolves them from its own
# Credentials Provider / DSH_HOME; never add secret values to this file.
